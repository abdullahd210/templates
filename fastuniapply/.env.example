# Copy to .env.local for development. No real secrets belong in this file.

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Database (PostgreSQL / Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fastuniapply?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fastuniapply?schema=public"

# --- Auth (Auth.js) ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- File storage (S3-compatible) ---
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=fastuniapply-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- Email ---
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="FastUniApply <no-reply@fastuniapply.com>"

# --- WhatsApp / notifications (optional in dev) ---
WHATSAPP_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_PHONE_ID=

# --- Security ---
RATE_LIMIT_REDIS_URL=
CRON_SECRET="generate-a-long-random-string"

# --- Analytics / SEO (optional) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_VERIFICATION_GOOGLE=
